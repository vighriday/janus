# Copy to .env and fill in. Never commit .env.
# The backend authenticates to Azure with DefaultAzureCredential, so locally
# `az login` is enough — you do not put Azure keys here.

# --- Azure AI Search (Foundry IQ knowledge base) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KNOWLEDGE_BASE=
AZURE_SEARCH_API_VERSION=2026-05-01-preview

# --- Azure AI Foundry project (model for planning / lesson extraction) ---
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_MODEL_DEPLOYMENT=

# --- Azure AI Content Safety (groundedness + prompt shields) ---
AZURE_CONTENT_SAFETY_ENDPOINT=

# --- Neo4j (local docker) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
