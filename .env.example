# Copy to .env and fill in. Never commit .env.
# The backend authenticates to Azure with DefaultAzureCredential, so locally
# `az login` is enough — there are no Azure keys in this file.

# --- Azure AI Search (Foundry IQ knowledge base) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KNOWLEDGE_BASE=janus-decisions-kb
AZURE_SEARCH_KNOWLEDGE_SOURCE=janus-decisions-ks
AZURE_SEARCH_API_VERSION=2026-05-01-preview

# --- Corpus blob source (keyless via the search service's managed identity) ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=corpus
AZURE_STORAGE_RESOURCE_ID=

# --- Azure OpenAI (planning / lesson extraction / groundedness / embeddings) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_GROUNDEDNESS_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure AI Content Safety (groundedness + prompt shields) ---
AZURE_CONTENT_SAFETY_ENDPOINT=

# Graph is in-process (NetworkX) — no server, no connection config.

# --- Observability (optional; both empty = spans recorded, nothing shipped) ---
# Local Arize Phoenix trace UI (docker compose up phoenix):
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# Production Azure Monitor (injected from Key Vault in the cloud; empty locally):
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
