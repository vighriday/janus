{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "searchEndpoint": { "value": "${AZURE_SEARCH_ENDPOINT}" },
    "searchResourceId": { "value": "${AZURE_SEARCH_RESOURCE_ID}" },
    "searchKnowledgeBase": { "value": "${AZURE_SEARCH_KNOWLEDGE_BASE=janus-decisions-kb}" },
    "searchKnowledgeSource": { "value": "${AZURE_SEARCH_KNOWLEDGE_SOURCE=janus-decisions-ks}" },
    "openAiEndpoint": { "value": "${AZURE_OPENAI_ENDPOINT}" },
    "openAiResourceId": { "value": "${AZURE_OPENAI_RESOURCE_ID}" },
    "contentSafetyEndpoint": { "value": "${AZURE_CONTENT_SAFETY_ENDPOINT}" },
    "contentSafetyResourceId": { "value": "${AZURE_CONTENT_SAFETY_RESOURCE_ID}" },
    "storageAccountResourceId": { "value": "${AZURE_STORAGE_ACCOUNT_RESOURCE_ID=}" }
  }
}
